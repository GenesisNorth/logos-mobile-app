# ==============================================================================
# LOGOS IN ME — Environment Configuration
# Copy this file to `.env` and fill in your credentials from Supabase:
#   cp .env.example .env
# ==============================================================================

# 1. Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
# Found in: Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=

# 2. Supabase Anonymous Public Key (starts with eyJhbGci...)
# Found in: Supabase Dashboard > Project Settings > API > Project API Keys > `anon` `public`
SUPABASE_ANON_KEY=

# 3. Optional: Groq Whisper API Key (starts with gsk_...)
# Free from: https://console.groq.com/keys
# Used for high-noise fallback speech recognition. If empty, uses 100% on-device speech ($0).
GROQ_API_KEY=

# 4. Optional: Stillness timer duration in seconds (defaults to 60)
STILLNESS_SECONDS=60
