<?xml version="1.0" encoding="utf-8"?>
<!-- Design: cream "This week" widget — four seeds and the streak. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_week"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_bold"
        android:letterSpacing="0.14"
        android:text="THIS WEEK"
        android:textColor="#B2622D"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/seed1" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="6dp" android:src="@drawable/seed_locked" android:contentDescription="Day 1" />
        <ImageView android:id="@+id/seed2" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="6dp" android:src="@drawable/seed_locked" android:contentDescription="Day 2" />
        <ImageView android:id="@+id/seed3" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="6dp" android:src="@drawable/seed_locked" android:contentDescription="Day 3" />
        <ImageView android:id="@+id/seed4" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/seed_locked" android:contentDescription="Day 4" />
    </LinearLayout>

    <TextView
        android:id="@+id/next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/figtree"
        android:maxLines="1"
        android:text=""
        android:textColor="#645C50"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_bold"
        android:text="0-day streak"
        android:textColor="#201E1D"
        android:textSize="12sp" />
</LinearLayout>
